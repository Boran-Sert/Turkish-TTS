{
  "model": {
    "model_path": "./Trendyol-TTS",
    "inference_timesteps": 8,
    "adaptive_timesteps": false,
    "cfg_value": 2.0,
    "max_length": 4096
  },
  "streaming": {
    "chunk_duration_ms": 200,
    "output_format": "pcm16_le",
    "enable_lookbehind": true,
    "lookbehind_mode": "anchor"
  },
  "text_processing": {
    "sentence_delimiters": ".?!…,;\n",
    "flush_timeout_ms": 500.0,
    "min_chars": 30
  },
  "system": {
    "voxcpm_gpu_ids": [
      0
    ],
    "use_torch_compile": true,
    "pool_acquire_timeout_s": 30.0,
    "ws_idle_timeout_s": 300.0
  },
  "api": {
    "cors_allowed_origins": [
      "*"
    ],
    "cors_allowed_methods": [
      "GET",
      "POST",
      "OPTIONS"
    ],
    "cors_allowed_headers": [
      "Content-Type",
      "Authorization",
      "X-Requested-With"
    ]
  }
}
